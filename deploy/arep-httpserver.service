# systemd unit for the sequential HTTP server.
#
# Installed as /etc/systemd/system/arep-httpserver.service on the EC2 instance.
# It makes the application a managed background service: it starts predictably,
# writes its log to a known location, stops cleanly and keeps running after the
# administration session closes.
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now arep-httpserver
#   sudo systemctl status arep-httpserver
#   sudo journalctl -u arep-httpserver -f      (or: tail -f /var/log/arep/server.log)
#   sudo systemctl stop arep-httpserver

[Unit]
Description=AREP sequential HTTP server (networking laboratory, part 2)
Documentation=https://github.com/Isaac1805BC/Minimal-HTTP-Server-to-a-Web-Application-on-AWS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arep
Group=arep
WorkingDirectory=/opt/arep

# The port is configuration, not code: the same artifact runs anywhere.
Environment=PORT=8080
ExecStart=/usr/bin/java -jar /opt/arep/arep-httpserver.jar

Restart=on-failure
RestartSec=5

# systemd creates and owns /var/log/arep.
LogsDirectory=arep
LogsDirectoryMode=0750
StandardOutput=append:/var/log/arep/server.log
StandardError=append:/var/log/arep/server.log

# The service only needs to read its own jar and listen on a high port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
